generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String // Now encrypted
  email     String   @unique // Now encrypted (but unique constraint on encrypted value)
  password  String // Already hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // Already encrypted

  // Relations
  backupCodes   BackupCode[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  code      String // Already hashed
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("backup_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Hashed token
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
